<form class="form-horizontal octoprusacam-settings" onsubmit="return false;">
    <div class="alert alert-info">
        <strong>OctoPrusaCam</strong> verbindet deine OctoPrint-Kameras mit <strong>Prusa Connect</strong>.
        Jede Kamera wird als eigenständige Snapshot-Kamera in Prusa Connect mit eigenem Token und Namen geführt.
    </div>

    <!-- Live Status Box (Overall) -->
    <div class="control-group">
        <label class="control-label">Status</label>
        <div class="controls">
            <div class="octoprusacam-status-badge">
                <!-- ko if: statusSuccess() === true -->
                <span class="label label-success"><i class="icon-ok-sign"></i> Verbunden / Upload OK</span>
                <!-- /ko -->
                <!-- ko if: statusSuccess() === false -->
                <span class="label label-important"><i class="icon-warning-sign"></i> Fehler beim Upload</span>
                <!-- /ko -->
                <!-- ko if: statusSuccess() === null -->
                <span class="label label-info"><i class="icon-info-sign"></i> Bereit / Nicht gestartet</span>
                <!-- /ko -->

                <span class="muted octoprusacam-status-text" data-bind="text: statusMessage"></span>
                <!-- ko if: statusTime() -->
                <small class="muted" style="display:block; margin-top:3px;">
                    Letzter Status: <span data-bind="text: statusTime"></span>
                </small>
                <!-- /ko -->
            </div>
        </div>
    </div>

    <hr/>

    <!-- General Settings -->
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.octoprusacam.enabled">
                <strong>Prusa Connect Camera Bridge aktivieren</strong>
            </label>
            <span class="help-block">Aktiviert den periodischen Bildupload an Prusa Connect für alle aktiven Kameras.</span>
        </div>
    </div>

    <!-- Upload Timing & Trigger (Global) -->
    <div class="control-group">
        <label class="control-label" for="octoprusacam_interval">Upload-Intervall</label>
        <div class="controls">
            <input id="octoprusacam_interval"
                   type="number"
                   min="2"
                   max="3600"
                   step="1"
                   class="input-mini"
                   data-bind="value: settingsViewModel.settings.plugins.octoprusacam.upload_interval">
            <span class="help-inline">Sekunden (Standard & Empfehlung von Prusa: <strong>10s</strong>)</span>
        </div>
    </div>

    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.octoprusacam.upload_only_printing">
                <strong>Nur während des Drucks hochladen</strong>
            </label>
            <span class="help-block">Pausiert den Upload aller Kameras, wenn der Drucker inaktiv ist.</span>
        </div>
    </div>

    <hr/>

    <!-- Multi-Camera Header & Tabs -->
    <div class="octoprusacam-camera-header clearfix">
        <h4 style="float: left; margin: 0 0 10px 0;">Kamera-Konfiguration</h4>
        <button type="button" class="btn btn-small btn-primary" style="float: right;" data-bind="click: addCamera">
            <i class="icon-plus"></i> Weitere Kamera hinzufügen
        </button>
    </div>

    <ul class="nav nav-tabs octoprusacam-camera-tabs">
        <!-- ko foreach: cameras -->
        <li data-bind="css: { active: $data === $root.selectedCamera() }">
            <a href="javascript:void(0);" data-bind="click: $root.selectCamera">
                <i class="icon-camera" data-bind="css: { 'text-success': lastStatusSuccess() === true, 'text-error': lastStatusSuccess() === false }"></i>
                <span data-bind="text: name() || 'Unbenannt'"></span>
                <!-- ko if: !enabled() -->
                <small class="muted" style="font-size: 10px;">(inaktiv)</small>
                <!-- /ko -->
            </a>
        </li>
        <!-- /ko -->
    </ul>

    <!-- Camera Tab Content -->
    <!-- ko if: selectedCamera -->
    <div class="octoprusacam-camera-content" data-bind="with: selectedCamera">
        <!-- Camera Toolbar -->
        <div class="octoprusacam-toolbar clearfix">
            <div style="float: left; margin-top: 5px;">
                <label class="checkbox inline">
                    <input type="checkbox" data-bind="checked: enabled">
                    <strong>Diese Kamera aktivieren</strong>
                </label>
                <!-- ko if: lastStatusMessage -->
                <span class="octoprusacam-cam-status-pill" data-bind="css: { 'text-success': lastStatusSuccess() === true, 'text-error': lastStatusSuccess() === false }">
                    &bull; <span data-bind="text: lastStatusMessage"></span>
                </span>
                <!-- /ko -->
            </div>
            <div style="float: right;">
                <button type="button" class="btn btn-small" data-bind="click: $root.duplicateCamera" title="Kamera duplizieren">
                    <i class="icon-copy"></i> Duplizieren
                </button>
                <button type="button" class="btn btn-small btn-danger" data-bind="click: $root.removeCamera, disable: $root.cameras().length <= 1" title="Kamera löschen" style="margin-left: 5px;">
                    <i class="icon-trash"></i> Löschen
                </button>
            </div>
        </div>

        <div style="clear: both; margin-bottom: 15px;"></div>

        <!-- Prusa Connect Zugangsdaten -->
        <fieldset>
            <legend>Prusa Connect Zugangsdaten</legend>

            <div class="control-group">
                <label class="control-label">Kamera-Name</label>
                <div class="controls">
                    <input type="text"
                           class="input-xlarge"
                           data-bind="value: name"
                           placeholder="z.B. Octoprint Cam oder Nozzle Cam">
                    <span class="help-block">
                        Name dieser Kamera in Prusa Connect und der Prusa App.
                    </span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">Kamera Token <span class="text-error">*</span></label>
                <div class="controls">
                    <div class="input-append">
                        <input class="input-xlarge"
                               data-bind="attr: { type: showToken() ? 'text' : 'password' }, value: token"
                               placeholder="z.B. a1b2c3d4e5f6... (20 Zeichen)">
                        <button class="btn" type="button" data-bind="click: toggleShowToken" title="Token anzeigen / verbergen">
                            <i data-bind="css: { 'icon-eye-open': !showToken(), 'icon-eye-close': showToken() }"></i>
                        </button>
                    </div>
                    <span class="help-block">
                        Erstelle in <strong>Prusa Connect</strong> unter <em>Drucker &rarr; Kamera &rarr; + Neue andere Kamera hinzufügen</em> eine Kamera und trage den dort angezeigten Token hier ein.
                    </span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">Fingerprint</label>
                <div class="controls">
                    <div class="input-append">
                        <input type="text"
                               class="input-xlarge"
                               data-bind="value: fingerprint"
                               placeholder="Eindeutige Kamera-ID (automatisch generiert)">
                        <button class="btn" type="button" data-bind="click: function() { $root.generateFingerprintForCamera($data); }" title="Neuen Fingerprint generieren">
                            <i class="icon-refresh"></i> Neu
                        </button>
                    </div>
                    <span class="help-block">
                        <strong>Hinweis:</strong> Der Fingerprint wird von OctoPrusaCam automatisch generiert und beim ersten Upload fest mit deinem Prusa Connect Token verknüpft (in Prusa Connect wird er <em>nicht</em> angezeigt).<br/>
                        <span class="text-warning"><i class="icon-warning-sign"></i> <strong>Wichtig:</strong> Ändere den Fingerprint nicht nachträglich! Bei einer Änderung verweigert Prusa Connect den Zugriff mit <strong>HTTP 403 Forbidden</strong>. In dem Fall muss in Prusa Connect eine neue Kamera angelegt werden.</span>
                    </span>
                </div>
            </div>
        </fieldset>

        <hr/>

        <!-- Camera Source & Image Adjustments -->
        <fieldset>
            <legend>Kamera-Quelle & Bildanpassung</legend>

            <div class="control-group">
                <label class="control-label">Snapshot-URL</label>
                <div class="controls">
                    <input type="text"
                           class="input-xxlarge"
                           data-bind="value: snapshot_url"
                           placeholder="Leer lassen für Standard-Webcam oder z.B. http://192.168.1.50:8080/?action=snapshot">
                    <span class="help-block">
                        Snapshot-URL für diese Kamera. Bei leerem Feld wird die Standard-Webcam aus OctoPrint verwendet. Für weitere Kameras kannst du hier deren individuelle Snapshot-URL eintragen.
                    </span>
                </div>
            </div>

            <!-- Basic Auth -->
            <div class="control-group">
                <label class="control-label">Authentifizierung (optional)</label>
                <div class="controls">
                    <div class="input-prepend">
                        <span class="add-on"><i class="icon-user"></i></span>
                        <input type="text"
                               class="input-medium"
                               data-bind="value: snapshot_auth_user"
                               placeholder="Benutzername">
                    </div>
                    <div class="input-prepend" style="margin-left: 10px;">
                        <span class="add-on"><i class="icon-key"></i></span>
                        <input type="password"
                               class="input-medium"
                               data-bind="value: snapshot_auth_pass"
                               placeholder="Passwort">
                    </div>
                    <span class="help-block">Nur erforderlich, wenn der Snapshot-Stream mit HTTP Basic Auth geschützt ist.</span>
                </div>
            </div>

            <!-- Rotation & Flip -->
            <div class="control-group">
                <label class="control-label">Bildausrichtung</label>
                <div class="controls">
                    <select class="input-medium" data-bind="value: rotate">
                        <option value="0">0° (Normal)</option>
                        <option value="90">90° im Uhrzeigersinn</option>
                        <option value="180">180° auf den Kopf</option>
                        <option value="270">270° im Uhrzeigersinn</option>
                    </select>
                    <label class="checkbox inline" style="margin-left: 15px;">
                        <input type="checkbox" data-bind="checked: flip_h"> Horizontal spiegeln
                    </label>
                    <label class="checkbox inline" style="margin-left: 15px;">
                        <input type="checkbox" data-bind="checked: flip_v"> Vertikal spiegeln
                    </label>
                </div>
            </div>
        </fieldset>

        <hr/>

        <!-- Test & Diagnostics per camera -->
        <fieldset>
            <legend>Verbindungstest & Vorschau (<span data-bind="text: name() || 'Diese Kamera'"></span>)</legend>

            <div class="control-group">
                <div class="controls">
                    <button type="button"
                            class="btn btn-info"
                            data-bind="click: function() { $root.testSnapshotForCamera($data); }, disable: isTesting">
                        <i class="icon-camera" data-bind="css: { 'icon-spin icon-spinner': isTestingSnapshot }"></i>
                        Lokalen Snapshot testen
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            style="margin-left: 10px;"
                            data-bind="click: function() { $root.testUploadForCamera($data); }, disable: isTesting">
                        <i class="icon-upload" data-bind="css: { 'icon-spin icon-spinner': isTestingUpload }"></i>
                        Snapshot an Prusa Connect hochladen (Test)
                    </button>
                </div>
            </div>

            <!-- Test Feedback Alert -->
            <!-- ko if: testFeedbackMessage -->
            <div class="control-group">
                <div class="controls">
                    <div class="alert" data-bind="css: { 'alert-success': testFeedbackSuccess(), 'alert-error': !testFeedbackSuccess() }">
                        <button type="button" class="close" data-bind="click: clearFeedback">&times;</button>
                        <!-- ko if: testFeedbackSuccess() -->
                        <strong><i class="icon-ok-sign"></i> Erfolg: </strong>
                        <!-- /ko -->
                        <!-- ko if: !testFeedbackSuccess() -->
                        <strong><i class="icon-exclamation-sign"></i> Fehler: </strong>
                        <!-- /ko -->
                        <span data-bind="text: testFeedbackMessage"></span>
                    </div>
                </div>
            </div>
            <!-- /ko -->

            <!-- Snapshot Preview Box -->
            <!-- ko if: previewImage -->
            <div class="control-group">
                <label class="control-label">Bildvorschau</label>
                <div class="controls">
                    <div class="octoprusacam-preview-box">
                        <img data-bind="attr: { src: previewImage }" alt="Kamera Snapshot Vorschau" class="octoprusacam-preview-img"/>
                    </div>
                    <span class="help-block">Zuletzt erfasster Snapshot für <strong data-bind="text: name"></strong>.</span>
                </div>
            </div>
            <!-- /ko -->
        </fieldset>
    </div>
    <!-- /ko -->
</form>
